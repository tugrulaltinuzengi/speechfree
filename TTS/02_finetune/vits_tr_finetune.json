{
  "model": "vits",
  "run_name": "vits_tr_finetune",
  "run_description": "VITS fine-tune on Turkish single-speaker data for SpeachFree TTS module",

  "audio": {
    "sample_rate": 22050,
    "win_length": 1024,
    "hop_length": 256,
    "fft_size": 1024,
    "num_mels": 80,
    "mel_fmin": 0,
    "mel_fmax": null,
    "preemphasis": 0.0,
    "ref_level_db": 20,
    "do_sound_norm": false,
    "do_trim_silence": true,
    "trim_db": 45
  },

  "batch_size": 16,
  "eval_batch_size": 8,
  "num_loader_workers": 4,
  "num_eval_loader_workers": 4,
  "run_eval": true,
  "test_delay_epochs": 5,
  "epochs": 1000,
  "save_step": 500,
  "print_step": 25,
  "mixed_precision": true,

  "text_cleaner": "turkish_cleaners",
  "use_phonemes": false,
  "characters": {
    "pad": "<PAD>",
    "eos": "<EOS>",
    "bos": "<BOS>",
    "blank": "<BLNK>",
    "characters": "abcçdefgğhıijklmnoöprsştüüvyz !',.-?",
    "punctuations": "!',.-? ",
    "phonemes": null
  },

  "model_args": {
    "num_chars": 44,
    "spec_segment_size": 32,
    "hidden_channels": 192,
    "hidden_channels_ffn_text_encoder": 768,
    "num_heads_text_encoder": 2,
    "num_layers_text_encoder": 6,
    "kernel_size_text_encoder": 3,
    "dropout_p_text_encoder": 0.1,
    "dropout_p_duration_predictor": 0.5,
    "kernel_size_posterior_encoder": 5,
    "dilatation_posterior_encoder": 1,
    "num_flows": 4,
    "kernel_size_flow": 5,
    "dilatation_flow": 1,
    "num_layers_flow": 4,
    "resblock_type_decoder": "1",
    "resblock_dilation_sizes_decoder": [[1,3,5],[1,3,5],[1,3,5]],
    "resblock_kernel_sizes_decoder": [3,7,11],
    "upsample_kernel_sizes_decoder": [16,16,4,4],
    "upsample_initial_channel_decoder": 512,
    "upsample_rates_decoder": [8,8,2,2],
    "periods_multi_period_discriminator": [2,3,5,7,11],
    "use_sdp": true
  },

  "optimizer": "AdamW",
  "optimizer_params": {
    "betas": [0.8, 0.99],
    "eps": 1e-9,
    "weight_decay": 0.01
  },
  "lr_scheduler": "ExponentialLR",
  "lr_scheduler_params": {
    "gamma": 0.99875,
    "last_epoch": -1
  },
  "lr": 2e-4,
  "lr_gen": 2e-4,
  "lr_disc": 2e-4,

  "use_speaker_embedding": false,
  "num_speakers": 1,
  "speakers_file": null,
  "speaker_embedding_channels": 256,
  "use_d_vector_file": false,

  "datasets": [
    {
      "formatter": "ljspeech",
      "meta_file_train": "data/metadata.csv",
      "meta_file_val": null,
      "path": "data/",
      "language": "tr-TR"
    }
  ],

  "output_path": "runs/vits_tr_finetune/",
  "restore_path": null,

  "test_sentences": [
    "Evet, merhaba.",
    "Hayır teşekkürler.",
    "Su içmek istiyorum.",
    "Yardım eder misiniz lütfen?",
    "Tamam, anlıyorum.",
    "Dur bir dakika.",
    "Gel buraya.",
    "Günaydın, nasılsınız?"
  ]
}
